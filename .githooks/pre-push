#!/usr/bin/env sh
set -e

RED='\033[31m'
YELLOW='\033[33m'
RESET='\033[0m'

fail() {
    printf "\n${RED}[pre-push] %s${RESET}\n\n" "$1" >&2
    printf "Bypass with --no-verify only in emergencies (CI will still gate).\n\n" >&2
    exit 1
}

if ! command -v cargo >/dev/null 2>&1; then
    printf "${YELLOW}[pre-push] cargo not found on PATH, skipping checks.${RESET}\n" >&2
    exit 0
fi

printf "[pre-push] cargo check --all-targets --all-features (with -D warnings)\n"
OUTPUT_FILE=$(mktemp 2>/dev/null || echo "$TMP/rastray-pre-push.$$")
if RUSTFLAGS="-D warnings" cargo check --all-targets --all-features >"$OUTPUT_FILE" 2>&1; then
    rm -f "$OUTPUT_FILE"
    exit 0
fi

if grep -qE "linker .* not found|link\.exe.* not found|linking with .* failed|ensure that Visual Studio|C\+\+ build tools" "$OUTPUT_FILE"; then
    printf "${YELLOW}[pre-push] cargo check cannot link locally (missing C/C++ toolchain).${RESET}\n" >&2
    printf "${YELLOW}[pre-push] CI will be the only build gate for this push. Proceeding.${RESET}\n" >&2
    rm -f "$OUTPUT_FILE"
    exit 0
fi

cat "$OUTPUT_FILE" >&2
rm -f "$OUTPUT_FILE"
fail "cargo check failed. CI will reject this push. Fix the warnings above."
