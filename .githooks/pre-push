#!/usr/bin/env sh
set -e

RED='\033[31m'
YELLOW='\033[33m'
RESET='\033[0m'

fail() {
    printf "\n${RED}[pre-push] %s${RESET}\n\n" "$1" >&2
    printf "Bypass with --no-verify only in emergencies (CI will still gate).\n\n" >&2
    exit 1
}

if ! command -v cargo >/dev/null 2>&1; then
    printf "${YELLOW}[pre-push] cargo not found on PATH, skipping checks.${RESET}\n" >&2
    exit 0
fi

printf "[pre-push] cargo check --all-targets --all-features (with -D warnings)\n"
RUSTFLAGS="-D warnings" cargo check --all-targets --all-features || \
    fail "cargo check failed. Fix the warnings above before pushing."

exit 0
